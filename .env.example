# ============================================================
# S.K.R. INTER COLLEGE ERP — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://skr_user:CHANGE_ME@localhost:5432/skr_college?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-characters"
# Generate with: openssl rand -base64 48

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Super Admin bootstrap (used only by seed script)
BOOTSTRAP_ADMIN_EMAIL="admin@skrcollege.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMeImmediately123!"
BOOTSTRAP_ADMIN_NAME="System Administrator"

# Optional: Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@skrcollege.local"

# Optional: SMS provider
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# Optional: Payment gateway (Razorpay example)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# File uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="10"

# Demo mode (never enable in production)
DEMO_MODE="true"
