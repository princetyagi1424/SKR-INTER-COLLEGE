# ============================================================
# S.K.R. INTER COLLEGE ERP — Environment Variables
# Copy to .env and fill real values. NEVER commit .env
# ============================================================

# MongoDB Atlas (or local MongoDB)
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/skr_college?retryWrites=true&w=majority"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-characters"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Super Admin bootstrap (seed only)
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMeImmediately123!"
BOOTSTRAP_ADMIN_NAME="System Administrator"

# Optional integrations (leave empty until configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@skrcollege.local"
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="10"
DEMO_MODE="true"
